# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=8h

# ─── Database ─────────────────────────────────────────────
# SQLite database file path (relative to project root)
DB_PATH=./data/sthappit.db

# ─── WhatsApp / Messaging ──────────────────────────────────
# Twilio credentials for WhatsApp reminders
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ─── Payment Gateway (Razorpay) ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Cleaning Timer ───────────────────────────────────────
# Minutes before a "Cleaning" bed auto-reverts to "Available"
# Set to 0 to require manual confirmation instead
CLEANING_AUTO_REVERT_MINUTES=120

# ─── Security ─────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
